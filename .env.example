# Local development only. This file is not automatically loaded by the
# PowerShell runner; set values in your terminal before starting the API.
APP_ENV=development
PORT=8080
ADMIN_PASSKEY=replace-with-a-local-only-passkey
# Optional locally; otherwise the API generates an ephemeral signing key.
# TOKEN_HMAC_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# VITE_API_BASE is public build configuration, not a credential. For local
# Vite development, leave it unset so the /api proxy is used. Production Pages
# builds use the GitHub Actions variable VITE_API_BASE with the API URL + /api.
# VITE_API_BASE=https://<api-id>.execute-api.ap-south-1.amazonaws.com/api

# The separate go-backend analysis service may need its own local token.
# ANALYSIS_API_TOKEN=replace-with-a-local-only-token
# ANALYSIS_SERVICE_URL=http://127.0.0.1:8081

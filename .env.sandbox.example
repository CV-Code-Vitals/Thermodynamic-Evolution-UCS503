# Example only. Production values are delivered to the instance through SSM.
IMAGE_TAG=replace-with-40-character-commit-sha
SANDBOX_SERVICE_TOKEN=replace-with-ssm-value
SANDBOX_WORKSPACE_HOST_DIR=/var/lib/ucs503/sandbox-workspaces
SANDBOX_TLS_CERT_SOURCE=/etc/ucs503/tls/broker.crt
SANDBOX_TLS_KEY_SOURCE=/etc/ucs503/tls/broker.key
DOCKER_GID=999

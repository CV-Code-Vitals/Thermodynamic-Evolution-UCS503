# Example only. Production values are delivered to the instance through SSM.
IMAGE_TAG=replace-with-40-character-commit-sha
AWS_REGION=ap-south-1
ANALYSIS_API_TOKEN=replace-with-ssm-value
SOURCE_BUCKET=replace-with-private-source-bucket-name
SANDBOX_SERVICE_TOKEN=replace-with-ssm-value
SANDBOX_SERVICE_URL=https://sandbox-private-host:8082
SANDBOX_INSTANCE_ID=i-0123456789abcdef0
SANDBOX_LIFECYCLE_TABLE=sandbox-lifecycle
SANDBOX_READY_TIMEOUT_SECONDS=180
SANDBOX_TLS_CA_SOURCE=/etc/ucs503/tls/sandbox-ca.crt
ANALYSIS_UPLOADS_HOST_DIR=/var/lib/ucs503-analysis/uploads
ENGINE_TIMEOUT_SEC=300
MAX_UPLOAD_MB=50

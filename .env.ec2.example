# Copy to .env on EC2. Use the outputs and SSM parameter names of the existing
# archive stack. The instance role must have the archive API's scoped AWS
# permissions. With Docker bridge networking, set the IMDSv2 hop limit to 2.
API_DOMAIN=api.example.com
AWS_REGION=ap-south-1
S3_BUCKET=existing-private-archive-bucket
DYNAMODB_TABLE=existing-archive-table
ADMIN_PASSKEY_PARAMETER=/ucs503/admin/passkey
TOKEN_HMAC_KEY_PARAMETER=/ucs503/admin/token-hmac-key
CORS_ALLOWED_ORIGINS=https://cv-code-vitals.github.io
SANDBOX_HOST_DIR=/opt/ucs503/sandboxes
SANDBOX_TLS_DIR=/opt/ucs503/tls
EVOLVE_MAX_CONCURRENCY=1

# Generate independent random server-side values. Never put these in Vite vars.
ANALYSIS_API_TOKEN=replace-with-a-random-service-token
SANDBOX_SERVICE_TOKEN=replace-with-a-different-random-broker-token
IMAGE_TAG=replace-with-the-tested-git-commit-sha
